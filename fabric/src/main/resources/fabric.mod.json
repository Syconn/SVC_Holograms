{
  "schemaVersion": 1,
  "id": "svc",
  "version": "${version}",
  "name": "SVC Holograms",
  "description": "A mod that add the Holographic Communicators from Syconn's Star Wars Mod and adds support for Simple Voice Chat Mod.",
  "authors": [
    "Syconn"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "All-Rights-Reserved",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mod.syconn.svc.fabric.SVCFabric"
    ],
    "client": [
      "mod.syconn.svc.fabric.client.SVCFabricClient"
    ],
    "voicechat": [
      "mod.syconn.svc.compat.vc.VoiceChatPlugin"
    ]
  },
  "mixins": [
    "svc.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.8",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
